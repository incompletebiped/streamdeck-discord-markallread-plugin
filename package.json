{
	"name": "streamdeck-discord-markallread-plugin",
	"version": "1.1.0",
	"private": true,
	"description": "Unofficial Stream Deck key that marks every Discord server as read.",
	"author": "incompletebiped",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/incompletebiped/streamdeck-discord-markallread-plugin.git"
	},
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "rollup -c",
		"test": "node --experimental-strip-types --test src/logic.test.ts",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.incompletebiped.discord-mark-read\"",
		"validate": "streamdeck validate com.incompletebiped.discord-mark-read.sdPlugin",
		"pack": "npm run build && streamdeck pack com.incompletebiped.discord-mark-read.sdPlugin --output dist --force"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.4"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.4",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@types/node": "^24.10.1",
		"rollup": "^4.52.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
