{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.incompletebiped.discord-mark-read",
	"Name": "Discord Read",
	"Version": "1.0.0.0",
	"Author": "incompletebiped",
	"URL": "https://github.com/incompletebiped/streamdeck-discord-markallread-plugin",
	"Description": "One key that marks every server as read in the Discord desktop app.",
	"CodePath": "bin/plugin.js",
	"Category": "Discord Read",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"PropertyInspectorPath": "ui/mark-all-read.html",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Actions": [
		{
			"Name": "Mark All Servers Read",
			"UUID": "com.incompletebiped.discord-mark-read.mark-all",
			"Icon": "imgs/actions/mark-all-read/icon",
			"Tooltip": "Marks every Discord server as read.",
			"PropertyInspectorPath": "ui/mark-all-read.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/mark-all-read/key",
					"TitleAlignment": "top",
					"FontSize": 12
				}
			]
		}
	]
}
